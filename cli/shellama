# Context files — attached to every prompt
_CONTEXT_FILE = os.path.join(os.path.expanduser('~/.shellama'), 'context.json')

def _load_context_paths():
    """Load context file list from disk."""
    import json as _json
    try:
        with open(_CONTEXT_FILE) as f:
            return _json.load(f)
    except Exception:
        return []

def _save_context_paths(paths):
    import json as _json
    os.makedirs(os.path.dirname(_CONTEXT_FILE), exist_ok=True)
    with open(_CONTEXT_FILE, 'w') as f:
        _json.dump(paths, f)

def _build_context_block():
    """Read all context files and return a block to prepend to prompts."""
    paths = _load_context_paths()
    if not paths:
        return ''
    parts = []
    for p in paths:
        expanded = os.path.expanduser(p)
        if not os.path.isabs(expanded):
            expanded = os.path.join(os.getcwd(), expanded)
        try:
            with open(expanded, 'r') as f:
                content = f.read()
            parts.append(f"--- CONTEXT FILE: {p} ---\n{content}\n--- END ---")
        except Exception as e:
            parts.append(f"--- CONTEXT FILE: {p} ---\n(error: {e})\n--- END ---")
    return '\n\n'.join(parts)

def context_add(path):
    paths = _load_context_paths()
    # Normalize: store relative if under cwd, else absolute
    abspath = os.path.abspath(os.path.expanduser(path))
    if not os.path.exists(abspath):
        print(f"shellama: {path}: not found", file=sys.stderr)
        return
    try:
        rel = os.path.relpath(abspath)
        store = rel if not rel.startswith('..') else abspath
    except ValueError:
        store = abspath
    if store in paths:
        print(f"shellama: {store} already in context", file=sys.stderr)
        return
    paths.append(store)
    _save_context_paths(paths)
    print(f"{CYAN}context added: {store}{RESET}")

def context_remove(path):
    paths = _load_context_paths()
    # Try exact match, then by basename, then by abspath
    abspath = os.path.abspath(os.path.expanduser(path))
    to_remove = None
    for p in paths:
        if p == path or os.path.abspath(os.path.expanduser(p)) == abspath:
            to_remove = p
            break
    if not to_remove:
        print(f"shellama: {path} not in context", file=sys.stderr)
        return
    paths.remove(to_remove)
    _save_context_paths(paths)
    print(f"{CYAN}context removed: {to_remove}{RESET}")

def context_list():
    paths = _load_context_paths()
    if not paths:
        print("shellama: no context files (use ,context add <file>)", file=sys.stderr)
        return
    total_size = 0
    for p in paths:
        expanded = os.path.expanduser(p)
        if not os.path.isabs(expanded):
            expanded = os.path.join(os.getcwd(), expanded)
        try:
            size = os.path.getsize(expanded)
            total_size += size
            print(f"  {YELLOW}{p}{RESET}  {GRAY}({size:,} bytes){RESET}")
        except Exception:
            print(f"  {YELLOW}{p}{RESET}  {GRAY}(missing){RESET}")
    print(f"{GRAY}total: {len(paths)} files, {total_size:,} bytes injected per prompt{RESET}", file=sys.stderr)

def context_clear():
    _save_context_paths([])
    print(f"{CYAN}context cleared{RESET}")

# Conversation branching
_branch_stack = []

def branch_start():
    """Fork the conversation — saves current conv ID and starts a new branch."""
    global SESSION_CONV_ID
    _branch_stack.append(SESSION_CONV_ID)
    SESSION_CONV_ID = str(_uuid.uuid4())
    os.environ['SHELLAMA_CONV_ID'] = SESSION_CONV_ID
    print(f"{CYAN}branched — exploring tangent (,branch back to return){RESET}")

def branch_back():
    """Return to the main conversation, discarding the branch."""
    global SESSION_CONV_ID
    if not _branch_stack:
        print("shellama: not in a branch", file=sys.stderr)
        return
    SESSION_CONV_ID = _branch_stack.pop()
    os.environ['SHELLAMA_CONV_ID'] = SESSION_CONV_ID
    print(f"{CYAN}returned to main conversation{RESET}")


# Try to fetch permissions from server (non-blocking, fallback to defaults)
def _fetch_permissions():
    global _READONLY_PATTERNS, _BLOCKED_PATTERNS, _READONLY_RE, _BLOCKED_RE
    try:
        resp = _session.get(f"{API_URL}/api/permissions", timeout=2)
        data = resp.json()
        _READONLY_PATTERNS = data.get('allowed', _READONLY_PATTERNS)
        extra_blocked = data.get('blocked_custom', [])
        _BLOCKED_PATTERNS = data.get('blocked_immutable', _BLOCKED_PATTERNS) + extra_blocked
    except Exception:
        pass  # Use defaults
    _READONLY_RE = [re.compile(p) for p in _READONLY_PATTERNS]
    _BLOCKED_RE = [re.compile(p) for p in _BLOCKED_PATTERNS]

_fetch_permissions()



        "  /\\  . ",
        "  /\\ .. ",
        "  /\\ ...",
    ]


class LlamaSpinner:
    """Animated llama spinner for backend requests."""
    def __init__(self):
        self._thread = None
        self._stop = False

    def start(self):
        self._stop = False
        self._thread = __import__('threading').Thread(target=self._spin, daemon=True)
        self._thread.start()

    def _spin(self):
        import time
        i = 0
        while not self._stop:
            frame = LLAMA_FRAMES[i % len(LLAMA_FRAMES)]
            sys.stderr.write(f"\r{YELLOW}{frame}{RESET}")
            sys.stderr.flush()
            i += 1
            time.sleep(0.3)
        sys.stderr.write("\r" + " " * 20 + "\r")
        sys.stderr.flush()
        sys.stdout.flush()

    def stop(self):
        self._stop = True
        if self._thread:
            self._thread.join()


spinner = LlamaSpinner()


def ai_chat(message, model):
    """Single chat round with the backend. Returns (response, tokens, elapsed, error)."""
    global session_tokens, session_requests, session_elapsed
    try:
        payload = {'message': message, 'model': model, 'conversation_id': SESSION_CONV_ID}
        resp = _session.post(
            f"{API_URL}/chat",
            json=payload,
            timeout=3600
        )
        data = resp.json()
        if data.get('error'):
            return None, 0, 0, data['error']
        data = _handle_fallback(data, '/chat', payload)
        tokens = data.get('total_tokens', 0)
        elapsed = data.get('elapsed', 0)
        session_tokens += tokens
        session_requests += 1
        session_elapsed += elapsed
        response_text = data.get('response', '')
        if data.get('cloud_fallback'):
            response_text += f"\n{GRAY}[cloud fallback: {data.get('cloud_model', 'cloud')}]{RESET}"
        elif data.get('cached'):
            response_text += f"\n{GRAY}[cached]{RESET}"
        return response_text, tokens, elapsed, None
    except KeyboardInterrupt:
        # User hit Ctrl+C — tell backend to stop
        try:
            _session.post(f"{API_URL}/stop-all", timeout=5)
        except Exception:
            pass
        return None, 0, 0, 'cancelled'
    except requests.exceptions.ConnectionError:
        return None, 0, 0, f"cannot reach {API_URL}"
    except Exception as e:
        return None, 0, 0, str(e)


# Auto-compaction threshold (~6000 tokens ≈ 24000 chars)
COMPACT_THRESHOLD = int(os.environ.get('SHELLAMA_COMPACT_THRESHOLD', '24000'))

def _auto_compact(conversation, system_prompt, quiet=False):
    """If conversation exceeds threshold, summarize older turns keeping recent ones."""
    if len(conversation) < COMPACT_THRESHOLD:
        return conversation

    # Split into system + turns
    # Keep system prompt and last 2 exchanges intact, summarize the middle
    after_system = conversation[len(system_prompt):]
    # Split on "User:" and "Assistant:" boundaries
    turns = re.split(r'\n\n(?=User:|Assistant:|Tool output:|Command output:)', after_system)

    if len(turns) <= 4:
        # Not enough turns to compact
        return conversation

    # Keep last 4 chunks (roughly last 2 exchanges), summarize the rest
    to_summarize = '\n\n'.join(turns[:-4])
    to_keep = '\n\n'.join(turns[-4:])

    # Ask the LLM to summarize
    summary_prompt = f"Summarize this conversation history concisely. Keep key facts, decisions made, files modified, and current task state. Be brief:\n\n{to_summarize}"
    summary, _, _, err = ai_chat(summary_prompt, MODEL)

    if err or not summary:
        return conversation  # Failed to compact, continue as-is

    if not quiet:
        print(f"{GRAY}[compacted: {len(conversation)} → {len(system_prompt) + len(summary) + len(to_keep) + 50} chars]{RESET}", file=sys.stderr)

    return f"{system_prompt}\n\nConversation summary (earlier turns):\n{summary}\n\n{to_keep}"


def ai_agent(query, quiet=False):
    """Agentic loop: AI can run commands and iterate."""
    global last_output
    os_info = subprocess.run(['uname', '-sr'], capture_output=True, text=True).stdout.strip()
    system = SYSTEM_PROMPT.format(os_info=os_info, cwd=os.getcwd())
    ctx = _build_context_block()
    if ctx:
        system += f"\n\nThe user has attached these files as context:\n\n{ctx}"
    conversation = f"{system}\n\nUser: {query}"

    total_tokens = 0
    total_elapsed = 0

    for round_num in range(MAX_ROUNDS):
        if not quiet:
            spinner.start()
        response, tokens, elapsed, err = ai_chat(conversation, MODEL)
        if not quiet:
            spinner.stop()
        if err:
            print(f"shellama: {err}", file=sys.stderr)
            return

        total_tokens += tokens
        total_elapsed += elapsed

        tool_blocks = extract_tool_blocks(response)

        if not tool_blocks:
            # Final answer — always show, even in quiet mode
            last_output = response
            _persist_last_output()
            if quiet:
                print(response)
            else:
                print(f"{CYAN}{response}{RESET}")
                print(f"{GRAY}[{round_num + 1} round{'s' if round_num else ''} | {total_elapsed:.1f}s | {total_tokens} tokens | {MODEL}]{RESET}", file=sys.stderr)
            return

        if not quiet:
            # Show reasoning text between tool blocks
            text_parts = re.split(r'```(?:bash|file_read|file_write\s*\S*|file_edit\s*\S*|web_search)\n.*?```', response, flags=re.DOTALL)
            for part in text_parts:
                part = part.strip()
                if part:
                    print(f"{CYAN}{part}{RESET}")
            print(f"{GRAY}[round {round_num + 1} | {elapsed:.1f}s | {tokens} tokens]{RESET}", file=sys.stderr)

        # Execute each tool and collect output
        cmd_outputs = []
        for tool_type, tool_data in tool_blocks:
            sys.stderr.write("\n")

            if tool_type == 'web_search':
                print(f"{YELLOW}┌─ 🔍 search: {tool_data}{RESET}")
                output = run_web_search(tool_data)
                if not quiet:
                    lines = output.splitlines()
                    preview = '\n'.join(lines[:10])
                    print(f"{DIM}{preview}{RESET}")
                    if len(lines) > 10:
                        print(f"{DIM}   ... ({len(lines)} lines){RESET}")
                cmd_outputs.append(f"[search: {tool_data}]\n{output}")

            elif tool_type == 'file_read':
                print(f"{YELLOW}┌─ 📖 read: {tool_data}{RESET}")
                if not quiet:
                    # Auto-allow reads
                    pass
                output = run_file_read(tool_data)
                if not quiet:
                    # Show truncated preview
                    lines = output.splitlines()
                    if len(lines) > 20:
                        preview = '\n'.join(lines[:10])
                        print(f"{DIM}{preview}\n   ... ({len(lines)} lines total) ...{RESET}")
                    else:
                        print(f"{DIM}{output}{RESET}")
                cmd_outputs.append(f"[read {tool_data}]\n{output}")

            elif tool_type == 'file_write':
                path, content = tool_data
                line_count = content.count('\n') + (1 if content and not content.endswith('\n') else 0)
                print(f"{YELLOW}┌─ ✏️  write: {path} ({line_count} lines){RESET}")
                if not quiet:
                    # Show preview of what will be written
                    preview_lines = content.splitlines()[:5]
                    for pl in preview_lines:
                        print(f"{DIM}  {pl}{RESET}")
                    if len(content.splitlines()) > 5:
                        print(f"{DIM}  ... ({len(content.splitlines())} lines total){RESET}")
                    try:
                        import termios
                        termios.tcflush(sys.stdin, termios.TCIFLUSH)
                    except Exception:
                        pass
                    try:
                        answer = input(f"{YELLOW}└─ Write? [y/N/q] {RESET}").strip().lower()
                    except (EOFError, KeyboardInterrupt):
                        print()
                        return
                    if answer == 'q':
                        return
                    if answer != 'y':
                        cmd_outputs.append(f"[write {path}]\n(skipped by user)")
                        print(f"{GRAY}   (skipped){RESET}")
                        continue
                output = run_file_write(path, content)
                print(f"{DIM}{output}{RESET}")
                cmd_outputs.append(f"[write {path}]\n{output}")

            elif tool_type == 'file_edit':
                path, edit_content = tool_data
                # Parse and show the edits
                edits = re.findall(r'<<<< SEARCH\n(.*?)\n====\n(.*?)\n>>>> END', edit_content, re.DOTALL)
                print(f"{YELLOW}┌─ 📝 edit: {path} ({len(edits)} change{'s' if len(edits)!=1 else ''}){RESET}")
                if not quiet:
                    for search, replace in edits[:3]:
                        s_preview = search.splitlines()[0][:60]
                        r_preview = replace.splitlines()[0][:60] if replace else '(delete)'
                        print(f"{DIM}  - {s_preview}{RESET}")
                        print(f"{DIM}  + {r_preview}{RESET}")
                    if len(edits) > 3:
                        print(f"{DIM}  ... and {len(edits)-3} more{RESET}")
                    try:
                        import termios
                        termios.tcflush(sys.stdin, termios.TCIFLUSH)
                    except Exception:
                        pass
                    try:
                        answer = input(f"{YELLOW}└─ Apply? [y/N/q] {RESET}").strip().lower()
                    except (EOFError, KeyboardInterrupt):
                        print()
                        return
                    if answer == 'q':
                        return
                    if answer != 'y':
                        cmd_outputs.append(f"[edit {path}]\n(skipped by user)")
                        print(f"{GRAY}   (skipped){RESET}")
                        continue
                output = run_file_edit(path, edit_content)
                print(f"{DIM}{output}{RESET}")
                cmd_outputs.append(f"[edit {path}]\n{output}")

            else:  # bash
                cmd = tool_data
                perm = _classify_command(cmd)

                if perm == 'block':
                    print(f"{RED}┌─ ⛔ BLOCKED: {cmd}{RESET}")
                    print(f"{RED}└─ This command is destructive and was blocked.{RESET}")
                    cmd_outputs.append(f"$ {cmd}\n(BLOCKED: destructive command not allowed)")
                    continue

                if perm == 'allow':
                    print(f"{YELLOW}┌─ $ {cmd}{RESET}")
                    # Auto-allowed (read-only)
                else:
                    print(f"{YELLOW}┌─ $ {cmd}{RESET}")
                    if not quiet:
                        try:
                            import termios
                            termios.tcflush(sys.stdin, termios.TCIFLUSH)
                        except Exception:
                            pass
                        try:
                            answer = input(f"{YELLOW}└─ Run? [y/N/q] {RESET}").strip().lower()
                        except (EOFError, KeyboardInterrupt):
                            print()
                            return
                        if answer == 'q':
                            return
                        if answer != 'y':
                            cmd_outputs.append(f"$ {cmd}\n(skipped by user)")
                            print(f"{GRAY}   (skipped){RESET}")
                            continue

                output = run_command(cmd)
                if output:
                    if quiet:
                        print(output)
                    else:
                        print(f"{DIM}{output}{RESET}")
                cmd_outputs.append(f"$ {cmd}\n{output}")

        # Feed results back
        results = '\n\n'.join(cmd_outputs)
        conversation += f"\n\nAssistant: {response}\n\nTool output:\n{results}\n\nContinue. If you have enough information, give your final answer as plain text without any tool blocks."

        # Auto-compact: if conversation is getting long, summarize older turns
        conversation = _auto_compact(conversation, system, quiet)

    print(f"{GRAY}[max rounds reached | {total_elapsed:.1f}s | {total_tokens} tokens]{RESET}", file=sys.stderr)


def _handle_fallback(data, endpoint, payload):
    """Check if backend suggests cloud fallback, prompt user, retry if approved."""
    if not data.get('fallback_available'):
        return data
    reason = data.get('fallback_reason', 'low quality')
    model = data.get('fallback_model', 'cloud')
    print(f"\n{YELLOW}⚠ Local model produced poor output: {reason}{RESET}", file=sys.stderr)
    print(f"{YELLOW}  Recommended fallback: {model}{RESET}", file=sys.stderr)
    try:
        answer = input(f"{GRAY}Use cloud fallback? [y/N] {RESET}").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return data
    if answer != 'y':
        return data
    # Retry with force_cloud
    payload['force_cloud'] = True
    try:
        spinner.start()
        resp = _session.post(f"{API_URL}{endpoint}", json=payload, timeout=3600)
        spinner.stop()
        return resp.json()
    except Exception as e:
        spinner.stop()
        print(f"shellama: fallback failed: {e}", file=sys.stderr)
        return data



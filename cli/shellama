SESSIONS_DIR = os.path.expanduser('~/.shellama/sessions')

def session_save(name=''):
    """Save current conversation session to disk."""
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    if not name:
        name = SESSION_CONV_ID[:8]
    filepath = os.path.join(SESSIONS_DIR, f'{name}.json')
    import json as _json
    data = {
        'conversation_id': SESSION_CONV_ID,
        'model': MODEL,
        'tokens': session_tokens,
        'requests': session_requests,
        'elapsed': session_elapsed,
        'cwd': os.getcwd(),
        'saved_at': __import__('time').time(),
    }
    with open(filepath, 'w') as f:
        _json.dump(data, f, indent=2)
    print(f"{CYAN}session saved: {name}{RESET}")
    print(f"{GRAY}{filepath}{RESET}", file=sys.stderr)


def session_load(name=''):
    """Load a saved conversation session."""
    global SESSION_CONV_ID, session_tokens, session_requests, session_elapsed
    import json as _json
    if not os.path.isdir(SESSIONS_DIR):
        print("shellama: no saved sessions", file=sys.stderr)
        return
    sessions = sorted(
        [f for f in os.listdir(SESSIONS_DIR) if f.endswith('.json')],
        key=lambda f: os.path.getmtime(os.path.join(SESSIONS_DIR, f)),
        reverse=True
    )
    if not sessions:
        print("shellama: no saved sessions", file=sys.stderr)
        return
    if name:
        matches = [s for s in sessions if name in s]
        if not matches:
            print(f"shellama: no session matching '{name}'", file=sys.stderr)
            return
        choice = matches[0]
    else:
        print(f"{CYAN}Saved sessions:{RESET}")
        for i, s in enumerate(sessions[:20]):
            path = os.path.join(SESSIONS_DIR, s)
            try:
                with open(path) as f:
                    meta = _json.load(f)
                import time as _time
                age = _time.time() - meta.get('saved_at', 0)
                if age < 3600:
                    ago = f"{int(age/60)}m ago"
                elif age < 86400:
                    ago = f"{int(age/3600)}h ago"
                else:
                    ago = f"{int(age/86400)}d ago"
                print(f"  {YELLOW}{i+1}{RESET}) {s[:-5]}  {GRAY}[{meta.get('requests',0)} reqs | {meta.get('tokens',0)} tok | {ago}]{RESET}")
            except Exception:
                print(f"  {YELLOW}{i+1}{RESET}) {s[:-5]}")
        try:
            pick = input(f"{YELLOW}Load [1-{min(len(sessions),20)}]: {RESET}").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not pick.isdigit() or int(pick) < 1 or int(pick) > min(len(sessions), 20):
            print("cancelled")
            return
        choice = sessions[int(pick) - 1]

    filepath = os.path.join(SESSIONS_DIR, choice)
    with open(filepath) as f:
        meta = _json.load(f)
    SESSION_CONV_ID = meta['conversation_id']
    os.environ['SHELLAMA_CONV_ID'] = SESSION_CONV_ID
    session_tokens = meta.get('tokens', 0)
    session_requests = meta.get('requests', 0)
    session_elapsed = meta.get('elapsed', 0.0)
    print(f"{CYAN}loaded session: {choice[:-5]} ({session_requests} reqs, {session_tokens} tokens){RESET}")
    if meta.get('cwd') and meta['cwd'] != os.getcwd():
        print(f"{GRAY}session was in: {meta['cwd']}{RESET}", file=sys.stderr)



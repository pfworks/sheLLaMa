def _classify_command(cmd):
    """Classify a bash command: 'allow', 'prompt', or 'block'."""
    stripped = cmd.strip()
    # Check blocked first
    for pat in _BLOCKED_RE:
        if pat.search(stripped):
            return 'block'
    # Check read-only
    for pat in _READONLY_RE:
        if pat.match(stripped):
            return 'allow'
    # Piped commands: if first command is readonly and rest are readonly/filters, allow
    if '|' in stripped:
        parts = [p.strip() for p in stripped.split('|')]
        if all(_classify_command(p) == 'allow' for p in parts):
            return 'allow'
    return 'prompt'


def run_command(cmd):
    """Run a bash command with user's env (aliases/functions) and return stdout+stderr."""
    try:
        result = subprocess.run(
            ['bash', '-c', f'source {BASH_ENV} 2>/dev/null; {cmd}'],
            capture_output=True, text=True, timeout=30,
            cwd=os.getcwd()
        )
        output = result.stdout
        if result.stderr:
            output += result.stderr
        # Truncate long output
        lines = output.split('\n')
        if len(lines) > 100:
            output = '\n'.join(lines[:50] + [f'\n... ({len(lines) - 100} lines truncated) ...\n'] + lines[-50:])
        return output.strip()
    except subprocess.TimeoutExpired:
        return "(command timed out after 30s)"
    except Exception as e:
        return f"(error: {e})"



def extract_tool_blocks(text):
    """Extract all tool blocks (bash, file_read, file_write, file_edit, web_search) from AI response."""
    blocks = []
    for m in re.finditer(r'```(bash|file_read|file_write(?:\s+\S+)?|file_edit(?:\s+\S+)?|web_search)\n(.*?)```', text, re.DOTALL):
        tag = m.group(1)
        content = m.group(2).strip()
        if not content:
            continue
        if tag == 'bash':
            blocks.append(('bash', content))
        elif tag == 'file_read':
            for line in content.splitlines():
                p = line.strip()
                if p:
                    blocks.append(('file_read', p))
        elif tag.startswith('file_edit'):
            path = tag.split(None, 1)[1] if ' ' in tag else ''
            blocks.append(('file_edit', (path, m.group(2))))
        elif tag == 'web_search':
            blocks.append(('web_search', content))
        else:
            # file_write path/to/file
            path = tag.split(None, 1)[1] if ' ' in tag else ''
            blocks.append(('file_write', (path, m.group(2))))  # preserve original content (no strip)
    return blocks


def extract_bash_blocks(text):
    """Extract bash code blocks from AI response (legacy, used by non-agent callers)."""
    blocks = re.findall(r'```bash\n(.*?)```', text, re.DOTALL)
    return [b.strip() for b in blocks if b.strip()]


def run_file_read(path):
    """Read a file and return numbered lines."""
    path = os.path.expanduser(path)
    if not os.path.isabs(path):
        path = os.path.join(os.getcwd(), path)
    try:
        with open(path, 'r') as f:
            lines = f.readlines()
        numbered = ''.join(f"{i+1:4d} | {line}" for i, line in enumerate(lines))
        return numbered if numbered else "(empty file)"
    except Exception as e:
        return f"Error: {e}"


def run_file_write(path, content):
    """Write content to a file, creating directories as needed."""
    path = os.path.expanduser(path)
    if not os.path.isabs(path):
        path = os.path.join(os.getcwd(), path)
    try:
        os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
        with open(path, 'w') as f:
            f.write(content)
        lines = content.count('\n') + (1 if content and not content.endswith('\n') else 0)
        return f"Wrote {lines} lines to {path}"
    except Exception as e:
        return f"Error: {e}"


def run_file_edit(path, edit_content):
    """Apply search-and-replace edits to an existing file."""
    path = os.path.expanduser(path)
    if not os.path.isabs(path):
        path = os.path.join(os.getcwd(), path)
    try:
        with open(path, 'r') as f:
            original = f.read()
    except Exception as e:
        return f"Error reading {path}: {e}"

    # Parse edit blocks: <<<< SEARCH ... ==== ... >>>> END
    edits = re.findall(r'<<<< SEARCH\n(.*?)\n====\n(.*?)\n>>>> END', edit_content, re.DOTALL)
    if not edits:
        return "Error: no valid SEARCH/REPLACE blocks found"

    result = original
    applied = 0
    failed = []
    for search, replace in edits:
        if search in result:
            result = result.replace(search, replace, 1)
            applied += 1
        else:
            failed.append(search[:60].replace('\n', '\\n'))

    if applied == 0:
        return f"Error: none of {len(edits)} edits matched. File unchanged."

    with open(path, 'w') as f:
        f.write(result)

    msg = f"Applied {applied}/{len(edits)} edits to {path}"
    if failed:
        msg += f"\nFailed to match: {'; '.join(failed)}"
    return msg


def run_web_search(query):
    """Search the web using DuckDuckGo and return text results."""
    import urllib.parse
    url = f"https://html.duckduckgo.com/html/?q={urllib.parse.quote(query)}"
    try:
        resp = _session.get(url, timeout=10, headers={'User-Agent': 'Mozilla/5.0'})
        # Extract result snippets from DDG HTML
        results = re.findall(r'<a rel="nofollow" class="result__a" href="([^"]+)"[^>]*>(.*?)</a>.*?<a class="result__snippet"[^>]*>(.*?)</a>', resp.text, re.DOTALL)
        if not results:
            # Fallback: try simpler pattern
            results = re.findall(r'class="result__a"[^>]*>(.*?)</a>', resp.text)
            if results:
                return '\n'.join(re.sub(r'<[^>]+>', '', r) for r in results[:5])
            return "(no results)"
        output = []
        for href, title, snippet in results[:5]:
            title = re.sub(r'<[^>]+>', '', title).strip()
            snippet = re.sub(r'<[^>]+>', '', snippet).strip()
            output.append(f"• {title}\n  {snippet}\n  {href}")
        return '\n\n'.join(output)
    except Exception as e:
        return f"Search error: {e}"


